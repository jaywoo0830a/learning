FROM debian:bookworm-slim

# Pandoc + XeLaTeX (수식 네이티브 렌더링) + 한글 폰트
RUN apt-get update && apt-get install -y --no-install-recommends \
    pandoc \
    texlive-xetex \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    lmodern \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# LaTeX 스타일 헤더
COPY header.tex /usr/local/share/header.tex

WORKDIR /work
ENTRYPOINT ["pandoc"]
