{
  "name": "math-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "math/graph — per-session figures for math/sessions, authored with @jaywoo0830a/logos.",
  "scripts": {
    "render": "cd .. && bash graph/node_modules/@jaywoo0830a/logos/scripts/render.sh -p . -s graph -o graphs -r --clean",
    "render:host": "logos render . --recursive --out ../graphs",
    "list": "logos list . --recursive"
  },
  "dependencies": {
    "@jaywoo0830a/logos": "github:jaywoo0830a/logos#v0.4.1"
  }
}
