# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Matplotlib / test artifacts (generated, not committed)
.mplconfig/

# Build outputs — graphs and rendered markdown are generated artifacts
graphs/
build/
scripts/graphs/*.png

# The build-output `graphs/` rule above would also ignore source files inside
# scripts/graphs/ — so explicitly re-include the .py sources there, keeping
# the generated .png outputs ignored.
!scripts/graphs/
!scripts/graphs/*.py

# Legacy + scaffolding: graph PNGs and one-off port helpers are not committed
sessions/**/graphs/
scripts/graphs/port_*.py
scripts/graphs/HEAD_*.py
scripts/graphs/ASSEMBLE.py

# Local dev scratch
.env